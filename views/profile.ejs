<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="icon" href="/favicon.ico?v=2" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
  <link rel="manifest" href="/site.webmanifest">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= user.username %>'s Profile - Snowwords</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --icy-turquoise: #06B6D4;
      --frost-blue: #3B82F6;
      --polar-night: #0F172A;
      --snow-white: #FFFFFF;
      --slate-50: #F8FAFC;
      --slate-100: #F1F5F9;
      --slate-200: #E2E8F0;
      --slate-700: #334155;
      --warning: #F59E0B;
      --danger: #EF4444;
      --success: #10B981;
      --gradient-primary: linear-gradient(135deg, #06B6D4 0%, #3B82F6 100%);
      --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
      --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1);
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--slate-50);
      color: var(--polar-night);
      -webkit-font-smoothing: antialiased;
    }

    header {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--slate-200);
      position: sticky;
      top: 0;
      z-index: 10;
      box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
    }

    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 1.25rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .navbar-brand a {
      background: var(--gradient-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-decoration: none;
      font-weight: 800;
      letter-spacing: -0.02em;
      font-size: 1.5rem;
    }

    .nav-links a {
      margin-left: 2rem;
      text-decoration: none;
      color: var(--polar-night);
      font-weight: 500;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .nav-links a.active { color: var(--frost-blue) }
    .nav-links a:hover { color: var(--frost-blue) }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 1.25rem;
    }

    .profile-header {
      background: white;
      border: 2px solid var(--slate-200);
      border-radius: 1.25rem;
      box-shadow: var(--shadow-xl);
      padding: 2rem;
      display: grid;
      align-items: center;
      grid-template-columns: auto 1fr auto;
      gap: 1.5rem;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .profile-header:hover {
      border-color: var(--frost-blue);
      box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.15);
    }

    .avatar-container {
      position: relative;
      width: 96px;
      height: 96px;
    }

    .avatar {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid #fff;
      box-shadow: 0 4px 12px rgba(0,0,0,.1);
    }

    .avatar-edit {
      position: absolute;
      bottom: -6px;
      right: -6px;
      background: var(--icy-turquoise);
      color: #fff;
      font-weight: 700;
      padding: .3rem .55rem;
      border-radius: 999px;
      border: 2px solid #fff;
      cursor: pointer;
      font-size: .85rem;
      box-shadow: 0 6px 14px rgba(126,200,216,.35);
    }

    .user-info { flex: 1; }
    .user-name-container { display:flex; align-items:center; gap:1rem; flex-wrap:wrap; margin-bottom:.5rem }
    .user-name { margin:0; font-size: 1.9rem; font-weight: 800; color: var(--polar-night) }
    .user-level { font-size: 1rem; color: var(--frost-blue) }
    .user-email { margin: .2rem 0 0 0; color: #5e7081; font-size: .95rem }

    .btn-settings {
      background: none;
      color: var(--frost-blue);
      border: 2px solid var(--frost-blue);
      padding: .4rem .8rem;
      border-radius: 20px;
      font-size: .9rem;
      transition: all .15s ease;
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      cursor: pointer;
    }
    .btn-settings:hover { background: rgba(70,130,180,.08) }

    .snowball-progress {
      background: var(--snow-white);
      border-radius: 50%;
      width: 100px;
      height: 100px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 3px solid var(--icy-turquoise);
    }
    .snowball-inner { text-align: center }
    .stat-number { font-size: 1.5rem; font-weight: bold; color: var(--frost-blue); }

    /* Cards and grids */
    .stats-grid { display:grid; grid-template-columns: repeat(auto-fit,minmax(280px,1fr)); gap:2rem; margin:2rem 0 }
    .stat-card {
      background: var(--snow-white);
      border: 1px solid var(--soft-sky);
      border-radius: 14px;
      box-shadow: 0 10px 24px rgba(70,130,180,.06);
      padding: 1rem 1rem 1.2rem 1rem;
    }
    .stat-card h3 { margin: 0 0 .6rem 0; color: var(--frost-blue) }

    .vocab-cloud {
      display:flex; flex-wrap:wrap; gap:.4rem; padding:.25rem;
      border:1px dashed var(--soft-sky); border-radius:12px; background:#fcfeff;
      min-height:48px;
    }
    .vocab-word {
      padding:.35rem .6rem; border:1px solid var(--soft-sky); border-radius:30px; background:#fff; font-size:.92rem;
    }
    .vocab-actions { margin-top:.7rem }
    .btn-vocab {
      background:none; color:var(--frost-blue); border:2px solid var(--icy-turquoise); padding:.45rem .85rem;
      border-radius: 22px; font-weight:700; display:inline-flex; align-items:center; gap:.5rem; text-decoration:none;
      transition:.15s all;
    }
    .btn-vocab:hover { background:var(--icy-turquoise); transform: translateY(-2px) }

    /* Achievements */
    .achievements-grid {
      display:grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 1.5rem;
      margin: 1rem 0;
    }
    .achievement-badge {
      text-align: center;
      padding: 1rem;
      background: var(--snow-white);
      border-radius: 12px;
      transition: transform 0.3s ease;
      border: 1px solid rgba(126, 200, 216, 0.2);
      box-shadow: 0 4px 15px rgba(70, 130, 180, 0.08);
    }
    .achievement-badge:hover { transform: translateY(-5px); }
    /* NEW: locked/unlocked & tiny progress */
    .achievement-badge.locked { opacity: 0.9; }
    .achievement-badge .ach-unlocked { color: var(--frost-blue); font-weight: 600; font-size: 0.85rem; }
    .achievement-badge .ach-progress { height: 8px; background: rgba(70,130,180,0.15); border-radius: 6px; overflow: hidden; margin-top: .35rem; }
    .achievement-badge .ach-progress-bar { height: 100%; background: linear-gradient(90deg, var(--icy-turquoise), var(--frost-blue)); }

    /* Small progress bars for stats */
    .mini { margin-top: .35rem; }
    .mini .row { display:flex; justify-content:space-between; align-items:center; gap:.5rem }
    .mini .bar { height:8px; background: rgba(126,200,216,0.25); border-radius:6px; overflow:hidden }
    .mini .bar > i { display:block; height:100%; background: var(--icy-turquoise) }
    .mono { font-variant-numeric: tabular-nums }

    /* Settings Panel */
    .settings-card {
      background: var(--snow-white);
      border: 1px solid var(--soft-sky);
      border-radius: 14px;
      box-shadow: 0 10px 24px rgba(70,130,180,.06);
      padding: 1.2rem;
      margin-top: 1rem;
      display: none;
    }
    .settings-card.visible { display: block; }

    .settings-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:1rem }
    .form-group { display:flex; flex-direction:column; gap:.35rem }
    .form-control, textarea, select {
      width: 100%;
      padding: .6rem .7rem;
      border: 1px solid var(--soft-sky);
      border-radius: 10px;
      background: #fff;
    }
    .btn-save {
      background: var(--frost-blue);
      color: #fff;
      border: none;
      padding: .6rem .9rem;
      border-radius: 10px;
      font-weight: 700;
      box-shadow: 0 6px 16px rgba(70,130,180,.25);
      cursor: pointer;
      transition: .15s transform;
    }
    .btn-save:hover { transform: translateY(-1px) }

    /* Premium / Free states */
    .premium-status, .free-status {
      padding: 1rem;
      border-radius: 12px;
      margin-top: 1rem;
      border: 1px solid var(--soft-sky);
      background: #f8fbff;
    }
    .premium-badge {
      display:inline-block; padding:.25rem .5rem; border-radius: 6px;
      background:#21618C; color:#fff; font-weight:800; font-size:.75rem; letter-spacing:.5px
    }
    .free-limits { margin:.5rem 0; padding-left:1.5rem }
    .free-limits li { margin-bottom:.45rem }

    .btn-primary {
      color: #fff;
      background: var(--frost-blue);
      border: none;
      padding: .6rem .9rem;
      border-radius: 10px;
      font-weight: 700;
      text-decoration: none;
      display: inline-block;
      box-shadow: 0 6px 16px rgba(70,130,180,.25);
      transition: .15s transform;
    }
    .btn-primary:hover { transform: translateY(-1px) }

    .btn-upgrade {
      background-color: #FF6B6B;
      color: white;
      padding: 8px 16px;
      border-radius: 4px;
      text-decoration: none;
      font-weight: bold;
      display: inline-block;
      margin-top: 10px;
      transition: background-color 0.2s;
    }
    .btn-upgrade:hover { background-color: #FF5252; }

    .btn-secondary {
      background: #fff;
      color: var(--polar-night);
      border: 1px solid var(--soft-sky);
      padding: .6rem .9rem;
      border-radius: 10px;
      font-weight: 700;
      text-decoration: none;
      display: inline-block;
      box-shadow: 0 2px 8px rgba(70,130,180,.15);
      transition: .15s transform;
    }
    .btn-secondary:hover { transform: translateY(-1px) }

    /* Modal styles (Avatar & Feedback) */
    .avatar-modal, .feedback-modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(43,58,74,.95);
      justify-content: center;
      align-items: center;
      z-index: 1000;
      backdrop-filter: blur(3px);
    }
    .avatar-modal-content, .feedback-modal-content {
      background: linear-gradient(145deg, var(--snow-white) 0%, #f0f4f7 100%);
      padding: 2.5rem;
      border-radius: 20px;
      width: 90%;
      max-width: 450px;
      text-align: center;
      box-shadow: 0 8px 32px rgba(0,0,0,.1);
      position: relative;
      border: 1px solid rgba(126,200,216,.3);
    }
    .avatar-modal-content h3, .feedback-modal-content h3 {
      margin: 0 0 1.5rem 0; color: var(--polar-night); font-size: 1.5rem; font-weight: 700;
    }
    .avatar-preview-container { display:flex; justify-content:center; margin: 0 0 1rem 0 }
    .avatar-preview {
      width: 180px; height: 180px; border-radius: 50%;
      object-fit: cover; border: 3px solid #fff; box-shadow: 0 4px 12px rgba(0,0,0,.08)
    }
    .close-modal {
      position:absolute; top:10px; right:14px; background:none; border:none; font-size:1.5rem; cursor:pointer; color:#90A4AE
    }
    .loading-spinner {
      width: 28px; height: 28px; border: 3px solid #e0e0e0; border-top-color: var(--frost-blue); border-radius: 50%;
      animation: spin 1s linear infinite; margin: 0 auto;
    }
    @keyframes spin { to { transform: rotate(360deg) } }

    .avatar-loading { display:none; margin-bottom:1rem }
    .feedback-modal-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:.6rem }
    .feedback-modal-body p { color:#5b6a79; line-height:1.45 }
    .feedback-modal-footer { display:flex; justify-content:flex-end; gap:.5rem; margin-top:.8rem }
    .emoji { margin-right:.35rem }

    /* Emoji fallback for avatars */
    .avatar-emoji{
      display:flex;align-items:center;justify-content:center;
      background:#fff;color:#4682B4;
      font-size:48px; /* header avatar size */
    }

    /* Bigger emoji for the preview in the modal */
    .avatar-preview-emoji{
      display:flex;align-items:center;justify-content:center;
      background:#fff;color:#4682B4;
      font-size:84px; /* modal preview size */
    }

  </style>
</head>
<body>
  <header>
    <nav class="navbar">
      <div class="navbar-brand">
        <a href="/" aria-label="Snowwords Home">❄️ Snowwords</a>
      </div>
      <div class="nav-links" role="navigation">
          <a href="/profile">Profile</a>
          <a href="/vocab">Vocab</a>
          <a href="/activities">Activities</a>
          <a href="/logout">Logout</a>
      </div>
    </nav>
  </header>

  <main class="container">
    <!-- Profile header -->
    <div class="profile-header">
      <div class="avatar-container">
        <% const hasAvatar = user.avatarUrl && String(user.avatarUrl).trim().length > 0; %>
        <% if (hasAvatar) { %>
          <img class="avatar" src="<%= user.avatarUrl %>" alt="Profile picture" />
        <% } else { %>
          <div class="avatar avatar-emoji" aria-label="No avatar">❄️</div>
        <% } %>

        <div class="avatar-edit" onclick="openAvatarEditor()">Edit</div>
      </div>

      <div class="user-info">
        <div class="user-name-container">
          <h1 class="user-name">
            <%= user.username %>
            <span class="user-level">❄️ <%= user.englishLevel || 'Beginner' %></span>
          </h1>
          <button class="btn-settings" onclick="toggleSettings()">⚙️ Settings</button>
        </div>
        <p class="user-email"><%= user.email %></p>
      </div>

      <div class="snowball-progress">
        <div class="snowball-inner">
          <div class="stat-number"><%= user.progress %></div>
          <small>/100 words</small>
        </div>
      </div>
    </div>

    <!-- Avatar Modal -->
    <div id="avatarModal" class="avatar-modal">
      <div class="avatar-modal-content">
        <div class="avatar-loading" id="avatarLoading"><div class="loading-spinner"></div></div>
        <h3>Update Your Profile Picture</h3>
        <div class="avatar-preview-container">
          <div class="avatar-preview-container">
            <% const hasAvatarPrev = user.avatarUrl && String(user.avatarUrl).trim().length > 0; %>
            <% if (hasAvatarPrev) { %>
              <img id="avatarPreviewImg" class="avatar-preview" src="<%= user.avatarUrl %>" alt="Avatar preview" />
            <% } else { %>
              <div id="avatarPreviewEmoji" class="avatar-preview avatar-preview-emoji" aria-label="No avatar">❄️</div>
            <% } %>
          </div>          
        </div>
        <form id="avatarForm" method="POST" enctype="multipart/form-data" action="/update-avatar">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
          <input id="avatarInput" type="file" name="avatar" accept="image/*"/>
          <div style="margin-top:1rem; display:flex; justify-content:flex-end; gap:.5rem">
            <button type="button" class="btn-secondary" onclick="closeAvatarEditor()">Cancel</button>
            <button type="submit" class="btn-primary">Save</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Settings Panel -->
    <div id="settingsContainer" class="settings-card">
      <form id="profileForm" action="/update-profile" method="POST" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="settings-grid">
          <div class="form-group">
            <label for="username">Display Name</label>
            <input class="form-control" id="username" name="username" type="text" value="<%= user.username %>"/>
          </div>

          <div class="form-group">
            <label for="englishLevel">English Level</label>
            <select class="form-control" id="englishLevel" name="englishLevel">
              <option value="Beginner" <%= user.englishLevel === 'Beginner' ? 'selected' : '' %>>Beginner</option>
              <option value="Elementary" <%= user.englishLevel === 'Elementary' ? 'selected' : '' %>>Elementary</option>
              <option value="Pre-Intermediate" <%= user.englishLevel === 'Pre-Intermediate' ? 'selected' : '' %>>Pre-Intermediate</option>
              <option value="Intermediate" <%= user.englishLevel === 'Intermediate' ? 'selected' : '' %>>Intermediate</option>
              <option value="Upper-Intermediate" <%= user.englishLevel === 'Upper-Intermediate' ? 'selected' : '' %>>Upper-Intermediate</option>
              <option value="Advanced" <%= user.englishLevel === 'Advanced' ? 'selected' : '' %>>Advanced</option>
            </select>
          </div>

          <div class="form-group" style="grid-column:1/-1">
            <label for="learningGoals">Learning Goals (comma-separated)</label>
            <textarea class="form-control" id="learningGoals" name="learningGoals" rows="3"><%= user.learningGoals %></textarea>
          </div>
        </div>

        <div style="display:flex;gap:.6rem;justify-content:flex-end;margin-top:.8rem">
          <button type="button" class="btn-secondary" onclick="closeSettings()">Close</button>
          <button type="submit" class="btn-save">Save Changes</button>
        </div>
      </form>
    </div>

    <!-- Premium / Free block -->
    <% if ((user.subscriptionStatus || 'free').toLowerCase() === 'premium') { %>
      <div class="premium-status">
        <div class="premium-badge">PREMIUM</div>
        <p>You're enjoying all premium features of Snowwords!</p>
        <div style="margin-top: 1rem; padding: 1rem; background: #f8f9fa; border-radius: 8px;">
          <h4 style="color: #4682B4; margin-bottom: 1rem;">🎯 Premium Features</h4>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
            <a href="/premium/crossword" style="background:#fff;border-radius:12px;padding:1rem;text-decoration:none;color:#2B3A4A;border:1px solid #dee2e6;">
              <div style="font-size:1.5rem;margin-bottom:.5rem">🧩</div>
              <h5 style="margin:0 0 .5rem 0;color:#4682B4">Crossword Puzzle</h5>
              <p style="margin:0;font-size:.9rem;color:#666">Challenge yourself with vocabulary puzzles</p>
            </a>
            <a href="/api/premium/vocab/export" style="background:#fff;border-radius:12px;padding:1rem;text-decoration:none;color:#2B3A4A;border:1px solid #dee2e6;">
              <div style="font-size:1.5rem;margin-bottom:.5rem">📥</div>
              <h5 style="margin:0 0 .5rem 0;color:#4682B4">Export Vocabulary</h5>
              <p style="margin:0;font-size:.9rem;color:#666">Download your vocabulary as CSV</p>
            </a>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="free-status">
        <p>You're currently on the <strong>Free Plan</strong> with the following limits:</p>
        <ul class="free-limits">
          <li>20 AI messages per day</li>
          <li>2 tests per day</li>
          <li>No access to premium games and activities</li>
        </ul>
        <p>Upgrade to Premium to unlock unlimited learning potential!</p>
        <a href="/subscription/plans" class="btn btn-primary btn-upgrade">Upgrade to Premium</a>
      </div>
    <% } %>

    <!-- Quick Stats & Goals -->
    <div class="stats-grid">
      <div class="stat-card">
        <h3>🌨️ Vocabulary Bank</h3>
        <div class="vocab-cloud">
          <% user.vocabulary.slice(0, 15).forEach(word => { %>
            <div class="vocab-word"><%= word.word %></div>
          <% }); %>
        </div>
        <div class="vocab-actions">
          <a href="/vocab" class="btn-vocab">
            View All Words (<%= user.vocabCount %>)
          </a>
        </div>
      </div>

      <div class="stat-card">
        <!-- IMPROVED STATS with mini progress bars -->
        <h3>⛄ Learning Stats</h3>
        <div class="mini">
          <div class="row"><span>Daily Streak</span><strong class="mono"><%= Number(user.streak||0) %> days</strong></div>
          <div class="bar" aria-label="Streak towards 30-day goal"><i style="width:<%= Math.max(0, Math.min(100, Math.round((Number(user.streak||0)/30)*100))) %>%"></i></div>
          <div class="subtle" style="font-size:.85rem">Goal: 30-day streak</div>
        </div>
        <div class="mini">
          <div class="row"><span>Total Learning Hours</span><strong class="mono"><%= Number(user.totalHours||0).toFixed(1) %> h</strong></div>
          <div class="bar" aria-label="Hours towards 20h goal"><i style="width:<%= Math.max(0, Math.min(100, Math.round((Number(user.totalHours||0)/20)*100))) %>%"></i></div>
          <div class="subtle" style="font-size:.85rem">Goal: 20 hours</div>
        </div>
        <div class="mini">
          <div class="row"><span>Accuracy</span><strong class="mono"><%= Math.round(Number(user.accuracy||0)) %>%</strong></div>
          <div class="bar" aria-label="Accuracy percentage"><i style="width:<%= Math.max(0, Math.min(100, Math.round(Number(user.accuracy||0)))) %>%"></i></div>
          <div class="subtle" style="font-size:.85rem">Higher is better</div>
        </div>
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <h3>🌨️ Current Goals</h3>
        <% if (user.learningGoals && user.learningGoals.trim().length > 0) { %>
          <ul>
            <% user.learningGoals.split(',').forEach(goal => { %>
              <% if (goal.trim()) { %>
                <li><%= goal.trim() %></li>
              <% } %>
            <% }); %>
          </ul>
        <% } else { %>
          <p>No goals set yet</p>
        <% } %>
      </div>

      <div class="stat-card">
        <!-- IMPROVED ACHIEVEMENTS (keeps your look, adds progress) -->
        <h3>🏆 Achievements</h3>
        <div class="achievements-grid">
          <% (user.achievements || []).forEach(function(a){ 
               const hasDetail = (a && (a.earned !== undefined || a.progress !== undefined || a.target !== undefined));
               const pct = hasDetail ? Math.max(0, Math.min(100, Math.round((Number(a.progress||0))*100))) : 100;
               const earned = hasDetail ? (!!a.earned || pct >= 100) : true;
          %>
            <div class="achievement-badge <%= earned ? 'earned' : 'locked' %>" title="<%= a.description || '' %>">
              <div style="font-size: 2rem;"><%= a.emoji || '🏆' %></div>
              <p style="margin:.35rem 0 .15rem 0;font-weight:600"><%= a.name || 'Achievement' %></p>
              <% if(!earned && a && a.target){ %>
                <div class="ach-progress" aria-label="Progress">
                  <div class="ach-progress-bar" style="width:<%= pct %>%"></div>
                </div>
                <small class="subtle"><%= pct %>%</small>
              <% } else { %>
                <small class="ach-unlocked">Unlocked</small>
              <% } %>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </main>

  <footer>
    <p>&copy; <%= new Date().getFullYear() %> Snowwords. All Rights Reserved.</p>
    <nav aria-label="Footer Navigation">
      <a href="/privacy-policy">Privacy Policy</a> •
      <a href="/terms">Terms of Service</a> •
      <a href="/feedback">Feedback</a>
    </nav>
  </footer>

  <!-- Feedback Modal -->
  <div id="feedbackModal" class="feedback-modal">
    <div class="feedback-modal-content">
      <div class="feedback-modal-header">
        <h3><span class="emoji">❄️</span> We'd Love Your Feedback!</h3>
        <button class="close-modal" onclick="closeFeedbackModal()">&times;</button>
      </div>
      <div class="feedback-modal-body">
        <p>Congratulations on adding <%= user.vocabCount %> words! We’d love to hear about your experience with SnowWords so far.</p>
        <form action="/feedback" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <textarea name="message" rows="4" placeholder="What do you like? What should we improve?" style="width:100%;border:1px solid var(--soft-sky);border-radius:10px;padding:.6rem"></textarea>
          <div class="feedback-modal-footer">
            <button class="btn-secondary" type="button" onclick="closeFeedbackModal()">Maybe Later</button>
            <button class="btn-primary" type="submit">Send Feedback</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    function toggleSettings(){ document.getElementById('settingsContainer').classList.toggle('visible'); }
    function closeSettings(){ document.getElementById('settingsContainer').classList.remove('visible'); }
    function openAvatarEditor(){ document.getElementById('avatarModal').style.display = 'flex'; }
    function closeAvatarEditor(){ document.getElementById('avatarModal').style.display = 'none'; }

    // Avatar upload preview
    const avatarInput = document.getElementById('avatarInput');
    if (avatarInput){
      avatarInput.addEventListener('change', function(e){
        const file = e.target.files && e.target.files[0];
        if (!file) return;

        const url = URL.createObjectURL(file);

        // If we were showing the emoji fallback, replace it with an <img>
        const emoji = document.getElementById('avatarPreviewEmoji');
        if (emoji) {
          const img = document.createElement('img');
          img.id = 'avatarPreviewImg';
          img.className = 'avatar-preview';
          img.alt = 'Avatar preview';
          img.src = url;
          emoji.replaceWith(img);
          return;
        }

        // Otherwise just update the existing <img>
        const img = document.getElementById('avatarPreviewImg');
        if (img) img.src = url;
      });
    }

    // Submit avatar with loading state
    const avatarForm = document.getElementById('avatarForm');
    if (avatarForm){
      avatarForm.addEventListener('submit', function(){
        document.getElementById('avatarLoading').style.display = 'block';
      });
    }

    // Feedback modal helpers
    function openFeedbackModal(){ document.getElementById('feedbackModal').style.display = 'flex'; }
    function closeFeedbackModal(){ 
      document.getElementById('feedbackModal').style.display = 'none';
      localStorage.setItem('feedbackShown', new Date().toISOString());
    }

    // Form validation (kept from your original)
    document.getElementById('profileForm').addEventListener('submit', function(e){
      const name = document.getElementById('username').value.trim();
      if(name.length === 0){
        e.preventDefault();
        showFieldError('username', 'Please enter your name');
        return false;
      }
    });

    function showFieldError(fieldId, message){
      const field = document.getElementById(fieldId);
      const errorDiv = document.createElement('div');
      errorDiv.className = 'field-error';
      errorDiv.textContent = message;
      field.parentNode.appendChild(errorDiv);
      setTimeout(()=>errorDiv.remove(), 3000);
    }

    // Dismiss modals by clicking backdrop
    window.addEventListener('click', (e) => {
      if (e.target.classList.contains('avatar-modal')) {
        closeAvatarEditor();
      }
      if (e.target.classList.contains('feedback-modal')) {
        closeFeedbackModal();
      }
    });
  </script>
</body>
</html>
