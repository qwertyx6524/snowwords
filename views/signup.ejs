<!DOCTYPE html>
<html>
  <head>
    <link rel="icon" href="/favicon.ico?v=2" sizes="any">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign Up - Snowwords</title>
    <style>
      /* Global: force full viewport height & disable scrolling - preserved as requested */
      html, body {
        height: 100vh;
        margin: 0;
        padding: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }
      
      /* Winter Theme Styles */
      :root {
        --icy-turquoise: #7EC8D8;
        --frost-blue: #4682B4;
        --snow-white: #F8F9FA;
        --polar-night: #2B3A4A;
      }
      
      body {
        font-family: 'Segoe UI', system-ui, sans-serif;
        color: var(--polar-night);
        background: var(--snow-white);
        line-height: 1.6;
      }
      
      /* The container with viewport-relative sizing */
      .container {
        width: 90%;
        max-width: 1200px;
        margin: 0 auto;
        padding: min(2rem, 2vh);
      }
      
      /* Divide the page into two vertical sections - using vh units to fit screens */
      .top-section {
        flex: 0 0 auto;
        max-height: 70vh; /* Ensure it doesn't take too much vertical space */
      }
      
      .section-sky {
        flex: 1 1 auto;
        background: linear-gradient(160deg, var(--frost-blue) 0%, var(--icy-turquoise) 100%);
        color: var(--snow-white);
        text-align: center;
        padding: min(4rem, 4vh) min(2rem, 2vw);
        position: relative;
        overflow: hidden;
      }
      
      .section-sky h1 {
        font-size: min(2.8rem, 5vh);
        margin-bottom: min(1.5rem, 2vh);
      }
      
      /* Scale signup card to fit viewports */
      .signup-card {
        background: white;
        border-radius: 16px;
        padding: min(2.5rem, 3vh) min(2.5rem, 3vw);
        box-shadow: 0 4px 20px rgba(70, 130, 180, 0.08);
        width: 90%;
        max-width: 500px;
        margin: min(2rem, 2vh) auto;
        /* Scale content to fit */
        font-size: min(1rem, 2vh);
      }
      
      .signup-card h2 {
        color: var(--frost-blue);
        text-align: center;
        margin-bottom: min(2rem, 2vh);
        font-size: min(1.5rem, 3vh);
      }
      
      form label {
        display: block;
        margin: min(1rem, 1vh) 0 min(0.5rem, 0.5vh);
        color: var(--polar-night);
        font-weight: 500;
      }
      
      form input, form select {
        width: 100%;
        padding: min(0.8rem, 1vh);
        border: 2px solid var(--icy-turquoise);
        border-radius: 8px;
        font-size: min(1rem, 2vh);
        margin-bottom: min(1rem, 1vh);
        transition: all 0.3s ease;
        box-sizing: border-box;
      }
      
      form input:focus, form select:focus {
        outline: none;
        border-color: var(--frost-blue);
        box-shadow: 0 0 8px rgba(126, 200, 216, 0.3);
      }
      
      .btn {
        background: var(--icy-turquoise);
        color: white;
        width: 100%;
        padding: min(1rem, 1.5vh);
        border: none;
        border-radius: 8px;
        font-size: min(1.1rem, 2.2vh);
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: min(1.5rem, 1.5vh);
      }
      
      .btn:hover {
        background: var(--frost-blue);
        transform: translateY(-2px);
      }
      
      .badge-warm {
        background: #ffcccc;
        color: #cc0000;
        padding: min(1rem, 1vh);
        border-radius: 8px;
        width: 100%;
        text-align: center;
        margin: min(1rem, 1vh) 0;
        box-sizing: border-box;
      }
      
      .text-center {
        text-align: center;
        margin: min(2rem, 2vh) 0;
        font-size: min(1rem, 2vh);
      }
      
      .text-center a {
        color: var(--frost-blue);
        text-decoration: none;
        font-weight: 500;
      }
      
      .text-center a:hover {
        text-decoration: underline;
      }
      
      .btn-google {
        background: white;
        color: #4285f4;
        width: 100%;
        padding: min(0.8rem, 1vh);
        border: 2px solid #ddd;
        border-radius: 8px;
        font-size: min(1rem, 2vh);
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: min(1rem, 1vh);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-sizing: border-box;
      }
      
      .btn-google:hover {
        background: #f8f9fa;
        border-color: #4285f4;
        transform: translateY(-2px);
      }
      
      .google-icon {
        width: min(18px, 3vh);
        height: min(18px, 3vh);
      }
      
      .divider {
        display: flex;
        align-items: center;
        margin: min(1.5rem, 1.5vh) 0;
        color: var(--polar-night);
      }
      
      .divider::before,
      .divider::after {
        content: "";
        flex: 1;
        border-top: 2px solid var(--icy-turquoise);
        margin: 0 0.5rem;
      }
      
      /* For very small screens, preserve your original behavior */
      @media (max-width: 480px) or (max-height: 600px) {
        .signup-card {
          padding: min(1rem, 3vh);
          margin: min(0.5rem, 1vh) auto;
          width: 95%;
        }
        
        .container {
          width: 95%;
          padding: min(1rem, 1vh);
        }
        
        /* Further reduce spacing on very small screens */
        form label {
          margin: min(0.5rem, 0.5vh) 0 min(0.3rem, 0.3vh);
        }
        
        form input, form select {
          margin-bottom: min(0.5rem, 0.5vh);
          padding: min(0.6rem, 0.8vh);
        }
        
        .btn, .btn-google {
          padding: min(0.8rem, 1vh);
        }
        
        .text-center {
          margin: min(1rem, 1vh) 0;
        }
        
        /* Ensure hero section is not too large */
        .section-sky {
          padding: min(2rem, 2vh) min(1rem, 1vw);
        }
      }
      
      /* Ensure content fits on really small devices */
      @media (max-height: 500px) {
        .section-sky {
          display: none; /* Hide hero section on very small heights */
        }
        
        .top-section {
          max-height: 100vh;
        }
      }
    </style>
  </head>
  <body>
    <!-- Top Section: Form and Links -->
    <div class="top-section">
      <div class="container">
        <div class="signup-card">
          <h2>Build Your Snowwords Account ❄️</h2>
          
          <% if (error) { %>
            <div class="badge-warm">
              <%= error %>
            </div>
          <% } %>
  
          <form action="/signup" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" required>
  
            <label for="password">Password:</label>
            <input type="password" id="password" name="password" required>
  
            <label for="username">Username:</label>
            <input type="text" id="username" name="username" required>
  
            <label for="englishLevel">English Level:</label>
            <select id="englishLevel" name="englishLevel">
              <option value="Beginner">❄️ Beginner</option>
              <option value="Intermediate">🌨️ Intermediate</option>
              <option value="Advanced">⛄ Advanced</option>
            </select>
  
            <button class="btn" type="submit">Create Account</button>
            
            <div class="divider">or</div>
  
            <a href="/auth/google" class="btn-google">
              <svg class="google-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 488 512">
                <path d="M488 261.8C488 403.3 391.1 504 248 504 110.8 504 0 393.2 0 256S110.8 8 248 8c66.8 0 123 24.5 166.3 64.9l-67.5 64.9C258.5 52.6 94.3 116.6 94.3 256c0 86.5 69.1 156.6 153.7 156.6 98.2 0 135-70.4 140.8-106.9H248v-85.3h236.1c2.3 12.7 3.9 24.9 3.9 41.4z"/>
              </svg>
              Sign Up with Google
            </a>
          </form>
        </div>
        <div class="text-center">
          <p>Already have an account? <a href="/login">Log in here</a></p>
          <p><a href="/">Back to Home</a></p>
        </div>
      </div>
    </div>
  </body>
</html>