<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" href="/favicon.ico?v=2" sizes="any">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
    <link rel="manifest" href="/site.webmanifest">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Feedback - SnowWords</title>
    <style>
      /* Reusing your landing page styles with additions */
      :root {
        --icy-turquoise: #7EC8D8;
        --frost-blue: #4682B4;
        --snow-white: #F8F9FA;
        --polar-night: #2B3A4A;
      }

      body {
        font-family: 'Segoe UI', system-ui, sans-serif;
        margin: 0;
        padding: 0;
        color: var(--polar-night);
        background: var(--snow-white);
        line-height: 1.6;
      }

      .container {
        width: 90%;
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
      }

      /* Navbar - Same as landing page */
      .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem 2rem;
        background: var(--polar-night);
        box-shadow: 0 2px 10px rgba(43, 58, 74, 0.1);
      }

      .navbar-brand a {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--snow-white);
        text-decoration: none;
        letter-spacing: 0.5px;
      }

      .nav-links {
        display: flex;
        gap: 2rem;
        align-items: center;
      }

      .nav-links a {
        color: var(--snow-white);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.3s ease;
        padding: 0.5rem;
      }

      .nav-links a:hover {
        color: var(--icy-turquoise);
      }

      /* Feedback-specific styles */
      .feedback-hero {
        text-align: center;
        padding: 4rem 0 2rem;
        background: linear-gradient(160deg, var(--frost-blue) 0%, var(--icy-turquoise) 100%);
        color: var(--snow-white);
        border-radius: 0 0 30px 30px;
        margin-bottom: 2rem;
      }

      .feedback-hero h1 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
      }

      .feedback-form {
        background: white;
        padding: 2.5rem;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(70, 130, 180, 0.08);
        position: relative;
        overflow: hidden;
      }

      .feedback-form::before {
        content: '❄️';
        position: absolute;
        top: -20px;
        right: -10px;
        font-size: 4rem;
        opacity: 0.1;
        transform: rotate(15deg);
      }

      .form-group {
        margin-bottom: 1.5rem;
      }

      label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: var(--frost-blue);
      }

      input, select, textarea {
        width: 100%;
        padding: 0.8rem;
        border: 2px solid rgba(70, 130, 180, 0.2);
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.3s ease;
        box-sizing: border-box;
      }

      input:focus, select:focus, textarea:focus {
        border-color: var(--icy-turquoise);
        outline: none;
        box-shadow: 0 0 0 3px rgba(126, 200, 216, 0.3);
      }

      textarea {
        resize: vertical;
        min-height: 150px;
      }

      /* Alerts */
      .alert {
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .alert-success {
        background: #e8f6ef;
        color: #1a7d5d;
        border: 2px solid #4caf93;
      }

      .alert-danger {
        background: #fee;
        color: #dc3545;
        border: 2px solid #dc3545;
      }

      /* Buttons - Matching landing page */
      .btn-primary {
        background: var(--icy-turquoise);
        color: white;
        padding: 1rem 2rem;
        border: none;
        border-radius: 8px;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(126, 200, 216, 0.3);
        width: 100%;
        margin-top: 1rem;
      }

      .btn-primary:hover {
        background: var(--frost-blue);
        transform: translateY(-2px);
      }

      footer {
        background: var(--polar-night);
        color: var(--snow-white);
        text-align: center;
        padding: 2rem;
        margin-top: 4rem;
      }

      @media (max-width: 768px) {
        .navbar {
          flex-direction: column;
          gap: 1rem;
          padding: 1rem;
        }
        
        .feedback-form {
          padding: 1.5rem;
        }
      }
    </style>
</head>
<body>
    <header>
      <nav class="navbar">
        <div class="navbar-brand">
          <a href="/">❄️ Snowwords</a>
        </div>
        <div class="nav-links">
          <% if (user) { %>
            <a href="/profile">Profile</a>
            <a href="/logout">Logout</a>
          <% } else { %>
            <a href="/signup">Sign Up</a>
            <a href="/login">Login</a>
          <% } %>
        </div>
      </nav>
    </header>

    <div class="feedback-hero">
      <div class="container">
        <h1>Send Us Your Feedback ❄️</h1>
        <p>We value your opinions! Help us improve SnowWords with your suggestions.</p>
      </div>
    </div>

    <div class="container">
      <% if (success) { %>
        <div class="alert alert-success">
          ✓ Thank you for your feedback! We'll review it soon.
        </div>
      <% } %>
      
      <% if (error) { %>
        <div class="alert alert-danger">
          ⚠️ <%= error %>
        </div>
      <% } %>

      <form action="/feedback" method="POST" class="feedback-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="name">Your Name</label>
          <input type="text" id="name" name="name" required
              <% if (user) { %>value="<%= user.username %>"<% } %>>
        </div>
        
        <div class="form-group">
          <label for="email">Your Email</label>
          <input type="email" id="email" name="email" required
              <% if (user) { %>value="<%= user.email %>"<% } %>>
        </div>
        
        <div class="form-group">
          <label for="subject">Subject</label>
          <select id="subject" name="subject" required>
            <option value="">Select a topic</option>
            <option value="General Feedback">General Feedback</option>
            <option value="Bug Report">Bug Report</option>
            <option value="Feature Request">Feature Request</option>
            <option value="Content Suggestion">Content Suggestion</option>
            <option value="Other">Other</option>
          </select>
        </div>
        
        <div class="form-group">
          <label for="message">Your Message</label>
          <textarea id="message" name="message" required></textarea>
        </div>
        
        <button type="submit" class="btn btn-primary">Send Feedback</button>
      </form>
    </div>

    <footer>
      <p>&copy; <%= new Date().getFullYear() %> Snowwords. All Rights Reserved.</p>
      <nav aria-label="Footer Navigation">
        <a href="/privacy-policy">Privacy Policy</a>
      </nav>
    </footer>
</body>
</html>