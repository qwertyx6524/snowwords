<!-- views/subscription/success.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Subscription Success - Snowwords Premium</title>
  <style>
    /* Winter Theme Variables */
    :root {
      --icy-turquoise: #7EC8D8;
      --frost-blue: #4682B4;
      --snow-white: #F8F9FA;
      --polar-night: #2B3A4A;
      --accent-green: #4CAF50;
    }
    
    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      margin: 0;
      padding: 0;
      color: var(--polar-night);
      background: var(--snow-white);
      line-height: 1.6;
    }
    
    .container {
      width: 90%;
      max-width: 800px;
      margin: 0 auto;
      padding: 2rem;
      text-align: center;
    }
    
    /* Navbar */
    .navbar {
      background: var(--polar-night);
      padding: 1rem 2rem;
      box-shadow: 0 2px 10px rgba(43, 58, 74, 0.1);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    
    .navbar-brand a {
      color: var(--snow-white);
      font-size: 1.5rem;
      font-weight: 700;
      text-decoration: none;
    }
    
    .nav-links {
      display: flex;
      gap: 1.5rem;
      align-items: center;
    }
    
    .nav-links a {
      color: var(--snow-white);
      text-decoration: none;
      transition: color 0.3s ease;
    }
    
    .nav-links a:hover {
      color: var(--icy-turquoise);
    }
    
    .success-card {
      background: white;
      border-radius: 16px;
      padding: 3rem;
      margin: 3rem 0;
      box-shadow: 0 4px 20px rgba(70, 130, 180, 0.08);
    }
    
    .success-icon {
      font-size: 5rem;
      color: var(--accent-green);
      margin-bottom: 1rem;
    }
    
    .btn-primary {
      background: var(--icy-turquoise);
      color: white;
      padding: 1rem 2rem;
      border: none;
      border-radius: 8px;
      font-size: 1.1rem;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(126, 200, 216, 0.3);
      text-decoration: none;
      display: inline-block;
      margin-top: 2rem;
    }
    
    .btn-primary:hover {
      background: var(--frost-blue);
      transform: translateY(-2px);
    }
  </style>
</head>
<body>
  <!-- Navbar -->
  <div class="navbar">
    <div class="navbar-brand">
      <a href="/">❄️ Snowwords</a>
    </div>
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/profile">Profile</a>
      <a href="/logout">Logout</a>
    </div>
  </div>

  <div class="container">
    <div class="success-card">
      <div class="success-icon">✓</div>
      <h1>Subscription Complete!</h1>
      <p>Thank you for upgrading to Snowwords Premium!</p>
      <p>Your account has been upgraded, and you now have access to all premium features.</p>
      <p>Start enjoying unlimited messages, advanced games, and more today.</p>
      
      <a href="/profile" class="btn-primary">Go to Your Profile</a>
    </div>
  </div>

  <footer>
    <p>&copy; <%= new Date().getFullYear() %> Snowwords. All Rights Reserved.</p>
    <nav aria-label="Footer Navigation">
      <a href="/privacy-policy">Privacy Policy</a> | 
      <a href="/feedback">Share Feedback</a>
    </nav>
  </footer>
</body>
</html>